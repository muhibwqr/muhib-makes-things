      "destination": "/endeavours/",
      "permanent": true
    },
    {
      "source": "/work/",
      "destination": "/endeavours/",
      "permanent": true
    },
    {
      "source": "/writing",
      "destination": "/endeavours/",
      "permanent": true
    },
    {
      "source": "/writing/",
      "destination": "/endeavours/",
      "permanent": true
    },
    {
      "source": "/reasoning",
      "destination": "/my-purpose/",
      "permanent": true
    },
    {
      "source": "/reasoning/",
      "destination": "/my-purpose/",
      "permanent": true
    },
    {
      "source": "/memories",
      "destination": "/stills/",
      "permanent": true
    },
    {
      "source": "/memories/",
      "destination": "/stills/",
      "permanent": true
    },
    {
